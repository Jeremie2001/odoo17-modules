<?xml version="1.0" encoding="utf-8"?>


<odoo>
  <data>
    <record id="project_view_kanban_inherit" model="ir.ui.view">
    <field name="name">project.project.kanban.inherit</field>
    <field name="model">project.project</field>
    <field name="inherit_id" ref="project.view_project_kanban"/>
    <field name="arch" type="xml">

         <!-- <xpath expr="//field[@name='partner_id']" position="after">
          <field name="entreprise"/>
          <field name="total_commande"/>
          
        </xpath> -->
        
        <xpath expr="//t[@t-name='kanban-box']//div[hasclass('o_primary')]" position="after">
            <div t-if="record.sale_order_count.value > 0" class="text-muted small mt-1">
                <i class="fa fa-file-text-o mr-2"/> 
                <field name="sale_order_count" style="margin-left:7px !important;"/>

                <t t-if="record.sale_order_count.value == 1">
                            <t t-translation="on"> devis associé</t>
                        </t>
                        <t t-if="record.sale_order_count.value > 1">
                            <t t-translation="on"> devis associés</t>
                </t>
            </div>
<!-- 
              <div t-if="record.entreprise.value" class="text-muted small mt-1">
                <i class="fa fa-building-o mr-2"/>
                <field name="entreprise" widget="res_partner_many2one"  style="margin-left:7px !important;"/>
            </div>

            <div t-if="record.total_commande.value > 0" class="mt-1">
                <span class="badge badge-success">
                    <i class="fa fa-money"/> 
                    <field name="total_commande" widget="monetary"/>
                </span>
            </div> -->


        </xpath>
        
        
    </field>
</record>



 <record id="project_project_view_form_inherit" model="ir.ui.view">
    <field name="name">project.project.view.form.inherit</field>
    <field name="model">project.project</field>
    <field name="inherit_id" ref="project.project_project_view_form_simplified"/>
    <field name="arch" type="xml">
        <xpath expr="//field[@name='name']" position="after">

              <div class=" mt-2">
               <label for="description_projet" string="Description du projet" style="margin-right:15px !important;"/>

                  <span class="oe_edit_only o_row">
                
                  <field name="description_projet" class="mt-1 fs-6" placeholder="description du projet"/>


                  </span>
                 
              </div>
              
             <div class=" mt-2">
                  <label for="entreprise" string="Entreprise" style="margin-right:15px !important;"/>

                  <span class="oe_edit_only o_row">
                
                  <field name="entreprise" class="mt-1 fs-6" placeholder="choisir l'entreprise"/>


                  </span>
                 
              </div>



              <div class="mt-2">
              <label for="responsable" string="Responsable" style="margin-right:15px !important;"/>
              <span class="oe_edit_only o_row">
                  
                  <field name="responsable" class="mt-1 fs-6" placeholder="choisir le responsable"/>
                  

                   </span>
              </div>


        </xpath>
     
    </field>
</record>



<record id="project_kanban_inherit_buttons" model="ir.ui.view">
    <field name="name">project.project.kanban.inherit.buttons</field>
    <field name="model">project.project</field>
    <field name="inherit_id" ref="project.view_project_kanban"/>
    <field name="arch" type="xml">

         <xpath expr="//t[@t-name='kanban-menu']//div[@class='col-6' and @groups='project.group_project_manager']/a[@type='edit']" position="after">
            
            <a type="object" name="action_view_sale_orders" class="dropdown-item">
                <span class="fa fa-file-text-o me-1"/> Voir devis
            </a>

            <a type="object" name="action_create_quotation" class="dropdown-item">
                <span class="fa fa-plus-square me-1"/> Créer devis
            </a>

        </xpath>

    </field>
</record>

 
  </data>
</odoo>
