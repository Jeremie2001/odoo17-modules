<?xml version="1.0" encoding="utf-8"?>
<odoo>

  
     <record id="action_sale_copy_to_company_server" model="ir.actions.server">
        <field name="name">Copy to Another Company</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_view_types">form</field>
        <field name="state">code</field>
        <field name="code">
           action = env['sale.copy.wizard'].with_context(active_ids=records.ids).action_open_wizard()
        </field>
    </record>

    <record id="view_sale_order_intercompany_action_button" model="ir.ui.view">
        <field name="name">sale.order.intercompany.action.button</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- Bouton compteur "Copies" dans les stat buttons -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_open_intercompany_copies"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-copy"
                    invisible="intercompany_copy_count == 0"
                >
                    <field name="intercompany_copy_count" widget="statinfo" string="Copies"/>
                </button>
            </xpath>

            <!-- Champ origine inter-société -->
            <xpath expr="//field[@name='origin']" position="after">
                <field
                    name="intercompany_origin_id"
                    invisible="not intercompany_origin_id"
                    readonly="1"
                />
            </xpath>

        </field>
    </record>


        <record id="action_sale_copy_wizard_list" model="ir.actions.server">
        <field name="name">Copy to Another Company</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
            action = env['sale.copy.wizard'].with_context(active_ids=records.ids).action_open_wizard()
        </field>
    </record>

</odoo>